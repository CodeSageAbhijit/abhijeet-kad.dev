{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pulse/ev",
      "destination": "https://api-eu.mixpanel.com/track/"
    },
    {
      "source": "/pulse/ev/",
      "destination": "https://api-eu.mixpanel.com/track/"
    },
    {
      "source": "/pulse/:match*",
      "destination": "https://api-eu.mixpanel.com/:match*"
    }
  ]
}
