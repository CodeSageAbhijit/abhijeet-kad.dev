# Mixpanel analytics (leave empty or use a dev token locally)
VITE_MIXPANEL_TOKEN=your_mixpanel_project_token

# Optional: override Mixpanel ingestion endpoint for EU/India data residency
# EU: https://api-eu.mixpanel.com
# India: https://api-in.mixpanel.com
VITE_MIXPANEL_API_HOST=your_mixpanel_project_token
# Public browser credentials for the portfolio guestbook.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_pub_key